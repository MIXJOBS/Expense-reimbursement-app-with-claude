# ローカル開発用の環境変数サンプル。
# 実際の値は .env にコピーして使うこと（.env はコミット対象外）。

# --- PostgreSQL (docker-compose.yml の db サービスと対応) ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense
# ホスト側で別のPostgreSQLが5432を使っている場合に備え、デフォルトは5433で公開する。
# （コンテナ内部は常に5432。ホスト側公開ポートだけ変えればよい）
POSTGRES_PORT=5433

# apps/api (Prisma) が参照する接続文字列。
# ホストマシンからdocker-composeのPostgreSQLに繋ぐ場合は localhost:${POSTGRES_PORT} を使うこと。
DATABASE_URL="postgresql://expense:expense@localhost:5433/expense?schema=public"

# --- apps/api ---
PORT=3000

SEED_ADMIN_PASSWORD=""

# --- apps/api: CSRF対策(Origin検証)・CORSで許可するオリジン ---
# カンマ区切りで複数指定可能（例: "https://example.com,https://admin.example.com"）。
# NODE_ENV=production では必須（未設定だとアプリ起動時にエラーになる）。
# 開発環境では未設定時 "http://localhost:5173"（apps/web の開発サーバ）がデフォルトで使われる。
ALLOWED_ORIGINS="http://localhost:5173"

# リバースプロキシ（ロードバランサー等）配下での運用時のみ設定する。
# 未設定ならオフ（ロードバランサー無しの環境向けのデフォルト。X-Forwarded-For等の
# プロキシ由来ヘッダーを信頼しない）。
# 本番でロードバランサーの後ろに置く場合のみ、信頼するプロキシの段数（例: 1）を設定する。
TRUST_PROXY=""
