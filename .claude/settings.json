{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(docker compose *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm * add *)",
      "Bash(pnpm * prisma migrate reset *)",
      "Bash(git push *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"✅タスクが完了しました！\" with title \"Claude Code\" subtitle \"🏁処理終了！\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  }
}