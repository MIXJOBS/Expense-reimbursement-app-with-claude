{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(docker compose *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm * add *)",
      "Bash(pnpm * prisma migrate reset *)",
      "Bash(git push *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/terminal-notifier -title 'Claude Code' -subtitle '❓質問がきてるよ' -message 'クリックしてVSCodeを開く' -activate com.microsoft.VSCode -sound Ping"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/terminal-notifier -title 'Claude Code' -subtitle '🏁処理終了！' -message '✅タスクが完了しました！クリックしてVSCodeを開く' -activate com.microsoft.VSCode -sound Glass"
          }
        ]
      }
    ]
  }
}