// Prisma schema for the expense reimbursement app.
//
// 決定事項（CLAUDE.md参照）:
// - ID は UUID を使う（モデル追加時は `id String @id @default(uuid()) @db.Uuid` を基本形にする）
// - 金額は円の整数（Decimal/Floatではなく Int、小数のない円単位）を使う
// - 認証はCookieセッション（セッションはPostgreSQLに保存する想定。Session等のモデルは
//   認証フローの仕様確定後に追加する）
//
// 以下、PBI1（ログイン・ログアウト）・PBI2（ロールと権限）で確定した設計を反映。
// PBI3（経費申請の登録・編集）で ExpenseRequest を追加。
// PBI4（承認・差し戻し）で ExpenseRequest に approverId・returnReason を追加。
// PBI6（監査ログ）で AuditLog を追加（追記専用。トリガーはマイグレーションに手書き）。
// 経理確認（確認者・確認日時等のカラム）はPBI5のスコープのため、
// 現時点では追加しない（詳細は ExpenseRequest モデルのコメント参照）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User
// ============================================================
// - ロール名は packages/shared 側で定数管理する（Role.name は string だが
//   アプリ側では RoleName のUnion型に閉じて扱う）
// - ログイン失敗回数・ロックアウトはUser本体に持たせる方針。
//   理由：現在ロック中かどうかの判定にはUser1行のみ見れば済み、
//   更新も1行のUPDATEで完結するため競合が起きにくい。
model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String // argon2id のハッシュ文字列のみ保存。平文は保持しない。
  name         String

  // 自己参照：上長
  managerId    String? @db.Uuid
  manager      User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]  @relation("UserManager")

  // ログイン失敗・ロックアウト管理（PBI1: 5回連続失敗で15分ロック）
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? // nullならロックされていない。now() < lockedUntil ならログイン拒否。

  // 退職者等の論理削除フラグ。
  // - false の場合ログイン不可（エラーは AUTH_INVALID_CREDENTIALS に統一。
  //   ユーザー列挙対策として「無効化されている」ことは個別に教えない）
  // - false にする操作（無効化実行）は現時点のAPIスコープ外（将来PBI）。
  //   ただし「無効化された瞬間に全セッション破棄」は要件のため、無効化を実行する
  //   Service（将来実装）は必ず User.isActive 更新と Session 一括失効を
  //   同一トランザクションで行う設計にする（スキーマ上は Session.userId の
  //   リレーションで一括 UPDATE できる形になっている）。
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                    UserRole[]       @relation("UserRoleToUser")
  grantedRoles             UserRole[]       @relation("UserRoleGrantedBy") // 自分が付与したロール付与履歴
  sessions                 Session[]
  expenseRequests          ExpenseRequest[] @relation("ExpenseRequestApplicant") // 自分が申請者である経費申請（PBI3）
  approvingExpenseRequests ExpenseRequest[] @relation("ExpenseRequestApprover") // 自分が承認者（上長）である経費申請（PBI4）

  // 申請・監査ログ等の業務データが紐づく可能性があるため、Userはハードデリート不可の方針。
  // Userへの参照は基本的に onDelete: Restrict または SetNull とし、安易な連鎖削除を防ぐ。
  // ただし UserRole・Session は「Userに従属し、Userが消えたら一緒に消えるべきデータ」
  // であるため例外的に Cascade とする（これはUser自体の削除経路を提供する意味ではなく、
  // User自体の削除経路はアプリケーションとして提供しない。運用上は isActive=false のみ）。

  @@map("users")
}

// ============================================================
// Role
// ============================================================
// ロール名そのものの値（"APPLICANT" 等）は packages/shared の RoleName 定数で
// 一元管理し、DB上はマスタテーブルとして持つ（将来ロール追加がDBマイグレーションで
// 対応できるように name は unique な string とする）。
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique // packages/shared の RoleName のいずれかの値を想定
  createdAt DateTime @default(now())

  users UserRole[]

  @@map("roles")
}

// ============================================================
// UserRole（User と Role の中間テーブル）
// ============================================================
// - 誰が・いつ付与したかを残す（監査ログ本体はSprint3だが、最低限の
//   付与者・付与日時はここに持たせておくことで、監査ログInterceptor側で
//   変更前後の値を組み立てやすくする）
model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("UserRoleToUser", fields: [userId], references: [id], onDelete: Cascade)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  grantedById String? @db.Uuid // 付与した管理者のUser.id（システム初期投入等でnull許容）
  grantedBy   User?   @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  grantedAt DateTime @default(now())

  // 「最後のADMIN剥奪防止」チェックの排他制御（確定：悲観ロック）：
  // DELETE /admin/users/:userId/roles/:roleId の処理中、Prismaの $transaction 内で
  // ADMINロールを持つ UserRole 行集合に対して SELECT ... FOR UPDATE 相当の
  // 行ロックをかけた上で件数を数え、剥奪後に0件になる場合は拒否する。
  // Prismaの標準API（findMany等）は FOR UPDATE を発行できないため、実装時は
  // $transaction 内で $queryRaw（Prisma.sql）を使い
  // 「SELECT ... FROM user_roles ... WHERE role_id = :adminRoleId FOR UPDATE」
  // を発行してロック取得→カウント→DELETEを同一トランザクションで行う方式を取る
  // （楽観ロック(updatedAtやバージョン列での競合検出)ではなく、悲観ロックで
  // 同時剥奪のレースコンディションそのものを未然に防ぐ）。
  @@unique([userId, roleId]) // 同一ユーザーに同一ロールを重複付与しない
  @@map("user_roles")
}

// ============================================================
// Session
// ============================================================
// - Cookieに載せるセッションIDは「推測不能なランダム文字列」を想定するため、
//   id自体をUUIDにせず、別途「tokenHash」でDB検索する設計にする
//   （セッションIDをそのままDBキーにしてしまうと、DBダンプ漏洩時に
//   Cookie値が直接露出するリスクがあるため、平文トークンはハッシュ化して保存）。
// - ロール情報は持たない：セッションにロールをキャッシュせず、リクエスト毎にDBから
//   User→UserRoleを引いて権限判定する方針。これにより、管理者がロールを外した瞬間、
//   次のリクエストから即座に反映される（セッション無効化やキャッシュ破棄の仕組みを
//   別途作る必要がない）。
// - ログイン成功時のセッションID再発行（セッション固定対策）は、
//   「新規Sessionレコードを作り、旧レコードをrevoke（revokedAt設定）する」
//   運用で実現できる形にしておく。
model Session {
  id String @id @default(uuid()) @db.Uuid

  // Cookieに実際にセットする値はランダムな文字列(例: 32byte以上)。
  // DBには生の値を保存せず、SHA-256等でハッシュ化したものを保存する。
  tokenHash String @unique

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ipAddress String?

  // 絶対有効期限：ログイン成功時に now + 8h で固定し、以後更新しない。
  // この時刻を過ぎたら無条件で失効（スライディング判定より優先して先にチェック可）。
  expiresAt DateTime

  // 論理失効（ログアウト・再発行・無効化実行時にセット）。
  // 退職者無効化（isActive=false）実行時は、対象Userの全Session.revokedAtを
  // 一括更新することで「即ログアウト」を実現する想定（実行API自体は将来PBI）。
  revokedAt DateTime?

  createdAt DateTime @default(now())

  // スライディング有効期限の判定基準：now - lastSeenAt > 30分 の場合は失効。
  // 更新方針（確定）：毎リクエストではなく「前回更新から1分以上経過していた場合のみ
  // UPDATE する」間引きを行う。これにより書き込み負荷を抑えつつ、スライディング判定
  // (30分)の精度には実用上影響しない（1分の誤差は許容範囲）。
  // 実装イメージ（方針のみ、コードはここでは書かない）：
  //   if (now - session.lastSeenAt >= 1min) { UPDATE lastSeenAt = now }
  //   else { UPDATE はスキップし、既存の lastSeenAt のまま判定続行 }
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// ExpenseRequest（経費申請）
// ============================================================
// PBI3（経費申請の登録・編集）のスコープ：
//   下書き(DRAFT)の作成・編集・削除、提出(DRAFT/RETURNED→SUBMITTED)のみ。
// PBI4（承認・差し戻し）で以下を追加：
//   - approverId：提出(submit)時に申請者のUser.managerIdを保存する「承認者ID」。
//     承認・差し戻し操作の対象を絞り込むために使う（詳細はdocs/api/pbi-4.md）。
//   - returnReason：差し戻し時の理由（必須・500文字まで）。
// 経理確認（確認者・確認日時等）はPBI5のスコープのため、今回は追加しない
// （詳細はdocs/api/pbi-3.md・docs/api/pbi-4.mdの「判断に迷ったところ」を参照）。
model ExpenseRequest {
  id String @id @default(uuid()) @db.Uuid

  applicantId String @db.Uuid
  applicant   User   @relation("ExpenseRequestApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  // onDelete: Restrict — Userはハードデリートしない方針（User側コメント参照）のため、
  // 実運用では発火しないが、万一の削除経路でも経費申請データを連鎖削除しない。

  // 承認者ID（PBI4で追加）。提出(POST /expenses/:id/submit)時に、その時点の
  // 申請者のUser.managerIdを保存する。DRAFT段階では未設定のためnullable。
  // 差し戻し後の再提出でも同じsubmitエンドポイントが使われるため、その時点の
  // managerIdで上書きされる（特別な分岐は設けない。詳細はdocs/api/pbi-4.md）。
  // onDelete: Restrict — Userはハードデリートしない方針のため実運用では発火しないが、
  // 承認者（上長）が消えても承認待ちの申請を連鎖削除しないようにする。
  approverId String? @db.Uuid
  approver   User?   @relation("ExpenseRequestApprover", fields: [approverId], references: [id], onDelete: Restrict)

  // 利用日（経費が発生した日）。申請操作が行われた日時(createdAt)とは別の概念。
  expenseDate DateTime @db.Date

  // 金額は円の整数（CLAUDE.md決定事項）。1〜1,000,000円の範囲チェックはDTOで行うが、
  // DB制約としても不正値が入らないよう @db.Integer の範囲に収める
  // （PostgreSQLのInteger範囲で十分なため、桁あふれ対策のCheck制約は設けない）。
  amount Int

  // 科目区分。packages/shared の ExpenseCategory のいずれかの値を文字列で保存する
  // （Role.nameと同様の方針。選択肢が増える可能性を考えてEnumカラムではなくStringを
  // 採用し、packages/shared側の定数で一元管理する）。
  category String

  // 内容（詳細説明）。200文字までの制約はDTOで検証する。
  description String @db.VarChar(200)

  // ステータス。DRAFT固定で作成し、専用の提出APIでのみSUBMITTEDに変更する
  // （リクエストボディでは受け取らない。packages/sharedのExpenseStatusを文字列で保存）。
  status String @default("DRAFT")

  // 差し戻し理由（PBI4で追加）。差し戻し(RETURNED)時に必須・500文字まで。
  // 承認(APPROVED)時や、差し戻し後に再提出(SUBMITTED)された時点では意味を持たない値に
  // なるが、「前回差し戻された理由」を履歴として消す要件がないため、再提出時にクリアする
  // 処理は設けない（上書きは次に差し戻された時のみ発生する。詳細は判断に迷ったところ参照）。
  returnReason String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 一覧取得（GET /expenses）は必ず applicantId = 自分 の条件を付けて検索し、
  // createdAt降順でページネーションするため、[applicantId, createdAt]の複合インデックスを
  // 張る（実装着手時にソート順が確定したため、単体インデックスから複合インデックスに変更）。
  @@index([applicantId, createdAt])
  // 承認者視点の一覧取得（GET /approvals）は必ず
  // approverId = 自分 かつ status = SUBMITTED の条件で検索するため、
  // [approverId, status]の複合インデックスを張る（PBI4）。
  @@index([approverId, status])
  @@map("expense_requests")
}

// ============================================================
// AuditLog（監査ログ。PBI6）
// ============================================================
// 誰が・いつ・何に・何をしたか・結果・変更前後の値・IPアドレスを残す、追記専用のテーブル。
// 設計の詳細は docs/api/pbi-6.md を参照。
//
// 追記専用の担保（二重）：
// - アプリ：このテーブルへの update / updateMany / upsert / delete / deleteMany を
//   呼ぶコードを書かない（作成は AuditLogService.record の create のみ）。
// - DB：マイグレーションに手書きSQLで BEFORE UPDATE OR DELETE（行単位）と
//   BEFORE TRUNCATE（文単位）のトリガーを追加し、例外を投げて拒否する。
//   Prismaのスキーマ記法ではトリガーを表現できないため、`prisma migrate dev --create-only`
//   で生成したマイグレーションSQLに追記する（実装フェーズで行う。今回は作らない）。
//
// 外部キーを張らない理由（意図的）：
// - actorUserId / targetId は「記録した時点のID」の事実であり、対象（申請の削除など）が
//   後で消えてもログは残す必要がある（targetId は種類により参照先が違う多態参照でもある）。
// - 参照整合性のためにユーザー行・申請行の削除（e2eテストの後始末を含む）が監査ログに
//   邪魔されたり、逆に監査ログの追記専用トリガーとFKの連鎖動作が衝突したりするのを避ける。
// - 値の正しさは AuditLogService が書き込み時に保証する（呼び出し元は認証済みの
//   ユーザーIDと、同一トランザクション内で操作した対象のIDしか渡さない）。
//
// 機微情報を入れない：before / after はホワイトリスト方式（packages/shared の
// AUDIT_SNAPSHOT_FIELDS）で作る。password・passwordHash・Cookie・セッショントークンの
// 入る列・入り得る自由記述の列は、このテーブルに存在しない。
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  // いつ。DB側の clock_timestamp()（INSERT文の実行時刻）で採番する。
  // now() はトランザクション開始時刻になり、行ロックを待った側が「先に開始したが後に
  // コミットした」順序逆転を起こし得るため使わない（実行順＝記録順にする）。
  // タイムゾーンの取り違えを避けるため、他のモデルと違い timestamptz にする。
  occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  // 誰が。未認証の操作（ログイン失敗）は null。User への外部キーは張らない（上記参照）。
  actorUserId String? @db.Uuid
  // ログイン失敗時に入力されたメールアドレス（それ以外は null）。
  // 利用者が誤ってパスワードをメール欄に入れた可能性に備え、LoginDto の @IsEmail() を
  // 通った値だけを、254文字までで保存する（詳細は docs/api/pbi-6.md）。
  actorEmail String? @db.VarChar(254)

  // 何を / 結果。packages/shared の AuditAction / AuditResult / AuditFailureCode の値を
  // 文字列で保存する（Role.name・ExpenseRequest.status と同じ方針。Enumカラムにしない）。
  action      String
  result      String
  failureCode String?

  // 何に。packages/shared の AuditTargetType と対象のID。
  // 対象が特定できない場合（存在しないメールアドレスでのログイン失敗）は targetId が null。
  targetType String
  targetId   String? @db.Uuid

  // 変更前後の値。フラットなJSON（ネストなし）、8KB以内、ホワイトリストの項目のみ。
  // 状態を変えない操作（ログイン・ログアウト等）や、新規作成の before・削除の after は null。
  before Json?
  after  Json?

  // 操作元のIPアドレス（req.ip。IPv6なら最大45文字）。
  // TRUST_PROXY の設定次第でリバースプロキシのIPになる点に注意（docs/api/pbi-6.md）。
  ipAddress String? @db.VarChar(45)

  // 閲覧API（GET /admin/audit-logs）は occurredAt 降順＋id降順で並べ、
  // 操作者（actorUserId・actorEmail）・対象・期間で絞り込む。それぞれに対応するインデックス。
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  // actorEmail の完全一致での絞り込み（特定のメールアドレスへの攻撃の調査。PO判断No.4）。
  @@index([actorEmail, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@map("audit_logs")
}
